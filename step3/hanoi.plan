                caused clear(L) after move(D,L,L1).
                caused -clear(L1) after move(D,L,L1).
                inertial clear(L).

                forbidden on(D,L), on(D,L1), L<>L1.
                forbidden on(D,D).
                forbidden on(d2,d1).

noConcurrency.

